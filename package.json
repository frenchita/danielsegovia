{
  "name": "danielsegovia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "astro build && pagefind --site dist && node scripts/build-markdown.mjs dist",
    "preview": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply danielsegovia --local",
    "db:migrate:remote": "wrangler d1 migrations apply danielsegovia --remote",
    "check": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@fontsource/comic-neue": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "pagefind": "^1.6.0",
    "satori": "^0.63.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
