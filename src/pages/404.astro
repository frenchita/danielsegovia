---
import Base from '../layouts/Base.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import { t } from '../lib/i18n';
import { ogPath } from '../lib/content';

const ui = t('es');
---

<Base locale="es" title={`${ui.notFoundTitle} | Daniel Segovia`} description={ui.notFoundText} path="/404/" ogImage={ogPath('es/home')} noindex>
  <h1 class="page-title">{ui.notFoundTitle}</h1>
  <p>{ui.notFoundText} <a href="/">{ui.backHome}</a> · <a href="/en/" lang="en" hreflang="en">Page not found — back to home</a></p>
  <h2 class="section-title rainbow">{ui.moreCategories}</h2>
  <CategoryGrid locale="es" />
</Base>
