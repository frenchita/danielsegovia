---
import type { Locale } from '../lib/categories';
import { STATIC_PATHS, t } from '../lib/i18n';
import { abs } from '../lib/schema';
import { ADSENSE, SITE_NAME } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Comic Neue autoalojada (misma fuente que el sitio anterior), solo subset latin.
import comic300 from '@fontsource/comic-neue/files/comic-neue-latin-300-normal.woff2?url';
import comic700 from '@fontsource/comic-neue/files/comic-neue-latin-700-normal.woff2?url';

// Barra de progreso de lectura sin JS (scroll-driven animations). Va inline y sin minificar:
// el minificador la convierte en el shorthand `animation`, que Chrome rechaza con scroll().
const progressCss = `.progress{display:none}
@supports (animation-timeline: scroll()){
.progress{display:block;position:fixed;inset:0 0 auto 0;height:4px;background:var(--cat,var(--accent));transform-origin:0 50%;transform:scaleX(0);z-index:20;animation-name:progress-grow;animation-duration:auto;animation-timing-function:linear;animation-fill-mode:both;animation-timeline:scroll(root block)}
@keyframes progress-grow{to{transform:scaleX(1)}}}`;

const fontFaces = `
@font-face{font-family:'Comic Neue';font-style:normal;font-weight:300;font-display:swap;src:url(${comic300}) format('woff2')}
@font-face{font-family:'Comic Neue';font-style:normal;font-weight:700;font-display:swap;src:url(${comic700}) format('woff2')}`;

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta canónica de esta página (con barra final). */
  path: string;
  /** Rutas equivalentes en cada idioma (incluida la propia) para hreflang. */
  alternates?: Partial<Record<Locale, string>>;
  ogImage: string;
  ogType?: 'website' | 'article' | 'profile';
  article?: { publishedAt: string; modifiedAt: string; section: string };
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
  /** Si la página tiene bloques de AdSense (activa el loader diferido). */
  ads?: boolean;
  prev?: string;
  next?: string;
  /** Variables CSS de la categoría (colores de acento de la página). */
  catStyle?: string;
  /** Barra de progreso de lectura (solo CSS, scroll-driven animations). */
  progress?: boolean;
}

const { locale, title, description, path, alternates = {}, ogImage, ogType = 'website', article, jsonld, noindex = false, ads = false, prev, next, catStyle, progress = false } = Astro.props;
const ui = t(locale);
const canonical = abs(path);
const hreflangs = Object.entries(alternates) as [Locale, string][];
const xDefault = alternates.es ?? alternates.en;
// El script solo se carga si hay bloques manuales (con espacio reservado); así se evitan los Auto ads y sus saltos de layout.
const loadAds = ads && !!ADSENSE.client && ADSENSE.slots.some((s) => s.id);
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {hreflangs.length > 1 && hreflangs.map(([l, p]) => <link rel="alternate" hreflang={l} href={abs(p)} />)}
    {hreflangs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    {prev && <link rel="prev" href={abs(prev)} />}
    {next && <link rel="next" href={abs(next)} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} (${locale.toUpperCase()})`} href={abs(STATIC_PATHS.rss[locale])} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="author" content="Daniel Segovia" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={comic300} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={comic700} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={ui.ogLocale} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedAt} />
          <meta property="article:modified_time" content={article.modifiedAt} />
          <meta property="article:section" content={article.section} />
          <meta property="article:author" content={abs(STATIC_PATHS.about[locale])} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />

    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {ADSENSE.client && <meta name="google-adsense-account" content={ADSENSE.client} />}
    {loadAds && <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />}
    {
      progress && (
        <style is:inline set:html={progressCss}></style>
      )
    }
    <slot name="head" />
  </head>
  <body style={catStyle}>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <a class="skip" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header locale={locale} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer locale={locale} alternates={alternates} />
    {
      loadAds && (
        <script is:inline define:vars={{ client: ADSENSE.client }}>
          // AdSense se carga recién con el primer scroll del usuario (los bots y Lighthouse no scrollean).
          (function () {
            var done = false;
            function load() {
              if (done) return;
              done = true;
              removeEventListener('scroll', load);
              var s = document.createElement('script');
              s.async = true;
              s.crossOrigin = 'anonymous';
              s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
              document.head.appendChild(s);
              var slots = document.querySelectorAll('ins.adsbygoogle');
              for (var i = 0; i < slots.length; i++) (window.adsbygoogle = window.adsbygoogle || []).push({});
            }
            addEventListener('scroll', load, { passive: true });
          })();
        </script>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #111111;
    --muted: #5b5b5b;
    --line: #111111;
    --soft: #e6e6e6;
    --card: #ffffff;
    --accent: #1756e1;
    --code-bg: #f4f4f5;
    --radius: 6px;
    --max: 72rem;
    --font: 'Comic Neue', 'Comic Sans MS', 'Chalkboard SE', cursive;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 300 1.0625rem/1.6 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  img, svg { max-width: 100%; height: auto; display: block; }
  a { color: inherit; text-underline-offset: 0.18em; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  h1, h2, h3, h4 { line-height: 1.2; margin: 0 0 0.5em; font-weight: 700; }
  strong, b, th { font-weight: 700; }
  p { margin: 0 0 1em; }
  .container { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 16px; }
  .skip { position: absolute; left: -9999px; top: 0; background: var(--fg); color: var(--bg); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }
  .muted { color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Títulos de sección con la línea gruesa del boceto */
  .section-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--line);
    margin: 3rem 0 1.25rem;
  }
  .page-title {
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.4rem);
    padding-bottom: 0.6rem;
    border-bottom: 4px solid var(--cat, var(--line));
    margin: 1.5rem 0 1.5rem;
  }
  /* Línea con los colores de las 6 categorías */
  .rainbow {
    border-bottom: 4px solid transparent;
    border-image: linear-gradient(90deg, #1756e1, #e5484d, #7c3aed, #0f9d58, #f08c00, #d6249f) 1;
  }


  /* Layout contenido + columna de anuncios */
  .with-aside { display: grid; gap: 2rem; }
  @media (min-width: 960px) {
    .with-aside { grid-template-columns: minmax(0, 1fr) 300px; gap: 3rem; }
  }
</style>
