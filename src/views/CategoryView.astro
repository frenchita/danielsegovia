---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import EntryList from '../components/EntryList.astro';
import { catStyle, type Category, type Locale } from '../lib/categories';
import { categoryHasPage, categoryUrl, ogPath, type Entry } from '../lib/content';
import { STATIC_PATHS, t } from '../lib/i18n';
import { collectionPage, graph, type Crumb } from '../lib/schema';

interface Props {
  locale: Locale;
  category: Category;
  page: number;
  totalPages: number;
  entries: Entry[];
}
const { locale, category, page, totalPages, entries } = Astro.props;
const ui = t(locale);
const c = category[locale];
const path = categoryUrl(locale, category, page);
const firstPage = categoryUrl(locale, category);

const crumbs: Crumb[] = [
  { name: ui.home, path: STATIC_PATHS.home[locale] },
  { name: c.name, path: firstPage },
];

// hreflang solo en la página 1 y si existe la versión en el otro idioma.
const alternates: Partial<Record<Locale, string>> = {};
if (page === 1) {
  for (const l of ['es', 'en'] as const) {
    if (await categoryHasPage(l, category)) alternates[l] = categoryUrl(l, category);
  }
}

const title = page > 1 ? `${c.name} — ${ui.page} ${page} | Daniel Segovia` : `${c.name} | Daniel Segovia`;
const description = page > 1 ? `${c.description} ${ui.page} ${page}.` : c.description;
const prev = page > 1 ? categoryUrl(locale, category, page - 1) : undefined;
const next = page < totalPages ? categoryUrl(locale, category, page + 1) : undefined;
const jsonld = graph(collectionPage(locale, { name: c.name, description: c.description }, path, entries, crumbs));
---

<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  alternates={alternates}
  ogImage={ogPath(`${locale}/${category.key}`)}
  jsonld={jsonld}
  catStyle={catStyle(category)}
  prev={prev}
  next={next}
>
  <Breadcrumbs crumbs={crumbs} label={ui.breadcrumb} />
  <h1 class="page-title">{c.name}{page > 1 && <span class="muted"> · {ui.page} {page}</span>}</h1>

  {page === 1 && <p class="lead">{c.description}</p>}
  <EntryList locale={locale} entries={entries} page={page} totalPages={totalPages} pageHref={(p) => categoryUrl(locale, category, p)} />

  <h2 class="section-title rainbow">{ui.moreCategories}</h2>
  <CategoryGrid locale={locale} level={3} />
</Base>

<style>
  .lead { color: var(--muted); font-size: 1.05rem; max-width: 65ch; margin-bottom: 1.5rem; }
</style>
