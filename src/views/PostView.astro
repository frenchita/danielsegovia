---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import AdSlots from '../components/AdSlots.astro';
import { catStyle, type Locale } from '../lib/categories';
import { categoryHasPage, categoryUrl, relatedEntries, type Entry } from '../lib/content';
import { STATIC_PATHS, formatDate, t } from '../lib/i18n';
import { abs, blogPosting, graph, type Crumb } from '../lib/schema';

interface Props {
  entry: Entry;
}
const { entry } = Astro.props;
const locale: Locale = entry.locale;
const ui = t(locale);
const cat = entry.category[locale];
const catHref = (await categoryHasPage(locale, entry.category)) ? categoryUrl(locale, entry.category) : categoryUrl('es', entry.category);

// Inicio → Categoría → Nota (visible y en JSON-LD).
const crumbs: Crumb[] = [
  { name: ui.home, path: STATIC_PATHS.home[locale] },
  { name: cat.name, path: catHref },
  { name: entry.title, path: entry.url },
];
const related = await relatedEntries(entry);
const jsonld = graph(blogPosting(entry, crumbs));
const updated = entry.updatedAt.slice(0, 10) !== entry.publishedAt.slice(0, 10);
const url = abs(entry.url);
const share = [
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { name: 'X', href: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(entry.title)}` },
  { name: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${entry.title} ${url}`)}` },
];
const showToc = entry.toc.length >= 3;
let sourceHost = '';
if (entry.sourceUrl) {
  try {
    sourceHost = new URL(entry.sourceUrl).hostname.replace(/^www\./, '');
  } catch {
    sourceHost = '';
  }
}
---

<Base
  locale={locale}
  title={`${entry.title} | Daniel Segovia`}
  description={entry.excerpt}
  path={entry.url}
  alternates={entry.alternates}
  ogImage={entry.ogImage}
  ogType="article"
  article={{ publishedAt: entry.publishedAt, modifiedAt: entry.updatedAt, section: cat.name }}
  jsonld={jsonld}
  ads
  catStyle={catStyle(entry.category)}
  progress
>
  <Breadcrumbs crumbs={crumbs} label={ui.breadcrumb} />

  <div class="with-aside">
    <article data-pagefind-body>
      <header>
        <h1 class="page-title">{entry.title}</h1>
        <p class="meta muted">
          <a class="cat-pill" href={catHref} data-pagefind-filter="category">{cat.name}</a>
          {entry.isNew && <span class="new">{ui.isNew}</span>}
          <span>{ui.by} <a href={STATIC_PATHS.about[locale]} rel="author">Daniel Segovia</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={entry.publishedAt}>{formatDate(entry.publishedAt, locale)}</time>
          {updated && <><span aria-hidden="true">·</span><span>{ui.updatedOn} <time datetime={entry.updatedAt}>{formatDate(entry.updatedAt, locale)}</time></span></>}
          <span aria-hidden="true">·</span>
          <span>{entry.readingMinutes} {ui.minRead}</span>
        </p>
        <p class="lead">{entry.excerpt}</p>
      </header>
      {
        showToc && (
          <nav class="toc" aria-label={ui.toc}>
            <p class="toc-title">{ui.toc}</p>
            <ol>
              {entry.toc.map((h) => (
                <li><a href={`#${h.id}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose" set:html={entry.html} />
      {
        entry.sourceUrl && (
          <p class="source muted">
            {ui.source}: <a href={entry.sourceUrl} target="_blank" rel="noopener">{sourceHost || entry.sourceUrl}</a>
          </p>
        )
      }
      <div class="share" data-pagefind-ignore>
        <span class="share-title">{ui.share}</span>
        {share.map((s) => <a href={s.href} target="_blank" rel="noopener nofollow">{s.name}</a>)}
        <button type="button" data-url={url} data-done={ui.copied} onclick="navigator.clipboard&&navigator.clipboard.writeText(this.dataset.url).then(()=>{this.textContent=this.dataset.done})">{ui.copyLink}</button>
      </div>
    </article>
    <AdSlots locale={locale} />
  </div>

  {
    related.length > 0 && (
      <section>
        <h2 class="section-title">{ui.related}</h2>
        <ul class="related">
          {related.map((r) => (
            <li class="card">
              <a href={r.url}>{r.title}</a>
              <p>{r.excerpt}</p>
              <span class="mins">{r.readingMinutes} {ui.minRead}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2 class="section-title rainbow">{ui.moreCategories}</h2>
  <CategoryGrid locale={locale} level={3} />
</Base>

<style>
  .meta { font-size: 0.9rem; margin-top: -0.75rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.5rem; }
  .meta a { color: var(--fg); }
  .meta .cat-pill { background: var(--cat-tint); color: var(--cat-ink); font-weight: 700; text-decoration: none; padding: 0.1rem 0.7rem; border-radius: 999px; }
  .meta .new { background: var(--cat-ink); color: #fff; font-weight: 700; font-size: 0.8rem; padding: 0.1rem 0.6rem; border-radius: 999px; }
  .toc { border: 1px solid var(--soft); border-left: 4px solid var(--cat); padding: 0.9rem 1.1rem; margin: 0 0 1.75rem; max-width: 70ch; }
  .toc-title { font-weight: 700; margin: 0 0 0.4rem; }
  .toc ol { margin: 0; padding-left: 1.2rem; }
  .toc li { margin: 0.2rem 0; }
  .toc a { color: var(--cat-ink); text-decoration: none; display: inline-block; padding: 0.15rem 0; }
  .toc a:hover { text-decoration: underline; }
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--soft); }
  .share-title { font-weight: 700; margin-right: 0.25rem; }
  .share a, .share button {
    font: inherit; font-size: 0.9rem; font-weight: 700; color: var(--cat-ink); background: var(--cat-tint);
    border: 0; border-radius: 999px; padding: 0.35rem 0.9rem; text-decoration: none; cursor: pointer; min-height: 2.25rem; display: inline-flex; align-items: center;
  }
  .share a:hover, .share button:hover { background: var(--cat-ink); color: #fff; }
  .mins { margin-top: 0.6rem; font-size: 0.78rem; font-weight: 700; color: var(--cat-ink); }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 68ch; }
  .source { font-size: 0.9rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--soft); }

  .prose { font-size: 1.075rem; line-height: 1.75; max-width: 70ch; overflow-wrap: break-word; }
  .prose :global(h2) { font-size: 1.45rem; margin: 2rem 0 0.75rem; }
  .prose :global(h3) { font-size: 1.2rem; margin: 1.6rem 0 0.6rem; }
  .prose :global(h4) { font-size: 1.05rem; margin: 1.4rem 0 0.5rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(h2) { scroll-margin-top: 1rem; }
  .prose :global(h2)::before { content: ''; display: block; width: 2rem; height: 3px; background: var(--cat); margin-bottom: 0.5rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; margin: 0 0 1.2em; }
  .prose :global(li) { margin: 0.3em 0; }
  .prose :global(blockquote) { margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1.1rem; border-left: 4px solid var(--cat); background: var(--cat-tint); padding: 0.75rem 1rem; color: var(--fg); font-style: italic; }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.9em; background: var(--code-bg); padding: 0.12em 0.35em; border-radius: 4px; }
  .prose :global(pre) { background: var(--code-bg); padding: 1rem; border-radius: var(--radius); overflow-x: auto; line-height: 1.5; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--soft); margin: 2rem 0; }
  .prose :global(.table-wrap) { overflow-x: auto; margin: 1.5rem 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--soft); padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--code-bg); font-weight: 650; }
  .prose :global(mark) { background: #fde68a; color: #111; }

  .related { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .related { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card { border: 1px solid var(--soft); border-top: 4px solid var(--cat); padding: 1rem 1.1rem; display: flex; flex-direction: column; transition: border-color 0.15s ease; }
  .card:hover { border-color: var(--cat); }
  .card a { font-weight: 650; text-decoration: none; line-height: 1.3; display: block; margin-bottom: 0.4rem; }
  .card a:hover { text-decoration: underline; color: var(--cat-ink); }
  .card p { margin: 0; font-size: 0.92rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
