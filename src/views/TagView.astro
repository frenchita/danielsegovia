---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EntryList from '../components/EntryList.astro';
import type { Locale } from '../lib/categories';
import { ogPath, tagUrl, type Entry, type TagGroup } from '../lib/content';
import { STATIC_PATHS, t } from '../lib/i18n';
import { collectionPage, graph, type Crumb } from '../lib/schema';

interface Props {
  locale: Locale;
  tag: TagGroup;
  page: number;
  totalPages: number;
  entries: Entry[];
}
const { locale, tag, page, totalPages, entries } = Astro.props;
const ui = t(locale);
const path = tagUrl(locale, tag.slug, page);
const count = tag.entries.length;

const crumbs: Crumb[] = [
  { name: ui.home, path: STATIC_PATHS.home[locale] },
  { name: ui.tags, path: STATIC_PATHS.tags[locale] },
  { name: tag.name, path: tag.url },
];

const pageSuffix = page > 1 ? ` — ${ui.page} ${page}` : '';
const title = `${ui.tagHeading} ${tag.name}${pageSuffix} | Daniel Segovia`;
const description = `${ui.tagDescription} «${tag.name}» (${count} ${count === 1 ? ui.postCount : ui.postsCount}).${page > 1 ? ` ${ui.page} ${page}.` : ''}`;
const prev = page > 1 ? tagUrl(locale, tag.slug, page - 1) : undefined;
const next = page < totalPages ? tagUrl(locale, tag.slug, page + 1) : undefined;
const jsonld = graph(collectionPage(locale, { name: tag.name, description }, path, entries, crumbs));
// Los tags son propios de cada idioma, así que no hay equivalente para hreflang.
const alternates: Partial<Record<Locale, string>> = { [locale]: path };
---

<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  alternates={alternates}
  ogImage={ogPath(`${locale}/home`)}
  jsonld={jsonld}
  noindex={!tag.indexable}
  prev={prev}
  next={next}
>
  <Breadcrumbs crumbs={crumbs} label={ui.breadcrumb} />
  <h1 class="page-title"><span class="muted">#</span>{tag.name}{page > 1 && <span class="muted"> · {ui.page} {page}</span>}</h1>
  <p class="lead">{count} {count === 1 ? ui.postCount : ui.postsCount}</p>

  <EntryList locale={locale} entries={entries} page={page} totalPages={totalPages} pageHref={(p) => tagUrl(locale, tag.slug, p)} showCategory />

  <p class="all"><a href={STATIC_PATHS.tags[locale]}>{ui.allTags} →</a></p>
</Base>

<style>
  .lead { color: var(--muted); margin: -0.75rem 0 1.5rem; }
  .all { margin-top: 2.5rem; font-weight: 700; }
  .all a { color: var(--accent); }
</style>
