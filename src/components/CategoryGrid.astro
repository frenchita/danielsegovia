---
import { catStyle, type Locale } from '../lib/categories';
import { getBuckets } from '../lib/content';
import { t } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** Encabezado de los títulos de categoría (h2 en el home, h3 dentro de otras páginas). */
  level?: 2 | 3;
}
const { locale, level = 3 } = Astro.props;
const ui = t(locale);
const buckets = await getBuckets(locale);
const H = `h${level}` as 'h2' | 'h3';
---

<ul class="grid">
  {
    buckets.map((b) => (
      <li class="card" style={catStyle(b.category)}>
        <H class="cat">
          <a href={b.url} hreflang={b.hasPage ? undefined : 'es'}>{b.category[locale].name}</a>
        </H>
        {b.latest ? (
          <>
            {b.fallback && (
              <p class="label">
                <span class="badge" lang={locale}>{ui.inSpanish}</span>
              </p>
            )}
            <a class="post" href={b.latest.url} hreflang={b.fallback ? 'es' : undefined} lang={b.fallback ? 'es' : undefined}>
              {b.latest.title}
            </a>
            <p class="excerpt" lang={b.fallback ? 'es' : undefined}>{b.latest.excerpt}</p>
            <p class="pills">
              {b.latest.isNew && <span class="pill new">{ui.isNew}</span>}
              <span class="pill">{b.latest.readingMinutes} {ui.minRead}</span>
            </p>
          </>
        ) : (
          <p class="excerpt muted">{b.category[locale].description}</p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .card {
    border: 1px solid var(--soft);
    border-top: 5px solid var(--cat);
    padding: 1rem 1.1rem 1.1rem;
    background: var(--card);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--cat); transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .card, .card:hover { transition: none; transform: none; } }
  .cat { font-size: 1.5rem; margin-bottom: 0.6rem; }
  .cat a { text-decoration: none; color: var(--cat-ink); }
  .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 0 0 0.25rem; display: flex; gap: 0.5rem; align-items: center; }
  .badge { border: 1px solid var(--soft); border-radius: 999px; padding: 0 0.45rem; text-transform: none; letter-spacing: 0; }
  .post { font-weight: 700; font-size: 1.05rem; line-height: 1.3; text-decoration: none; margin-bottom: 0.4rem; }
  .post:hover { color: var(--cat-ink); text-decoration: underline; }
  .excerpt { font-size: 0.95rem; color: var(--muted); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pills { display: flex; gap: 0.4rem; margin: auto 0 0; padding-top: 0.75rem; }
  .pill { font-size: 0.75rem; background: var(--cat-tint); color: var(--cat-ink); padding: 0.1rem 0.6rem; border-radius: 999px; font-weight: 700; }
  .pill.new { background: var(--cat-ink); color: #fff; }
</style>
