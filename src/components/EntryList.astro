---
// Listado de notas con paginado. Lo usan las páginas de categoría y de tag.
// Cada nota toma los colores de su categoría (en un tag se mezclan categorías).
import { catStyle, type Locale } from '../lib/categories';
import type { Entry } from '../lib/content';
import { formatDate, t } from '../lib/i18n';

interface Props {
  locale: Locale;
  entries: Entry[];
  page: number;
  totalPages: number;
  /** URL de la página n del listado. */
  pageHref: (page: number) => string;
  /** Muestra la categoría de cada nota (en los tags, donde se mezclan). */
  showCategory?: boolean;
  emptyText?: string;
}
const { locale, entries, page, totalPages, pageHref, showCategory = false, emptyText } = Astro.props;
const ui = t(locale);
const prev = page > 1 ? pageHref(page - 1) : undefined;
const next = page < totalPages ? pageHref(page + 1) : undefined;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  entries.length === 0 ? (
    <p class="muted">{emptyText ?? ui.noPosts}</p>
  ) : (
    <ol class="list">
      {entries.map((e) => (
        <li style={catStyle(e.category)}>
          <article>
            <h2>
              <a href={e.url}>{e.title}</a>
            </h2>
            <p class="excerpt">{e.excerpt}</p>
            <p class="meta">
              {showCategory && <span class="pill cat">{e.category[locale].name}</span>}
              {e.isNew && <span class="pill new">{ui.isNew}</span>}
              <time datetime={e.publishedAt}>{formatDate(e.publishedAt, locale)}</time>
              <span aria-hidden="true">·</span>
              <span>{e.readingMinutes} {ui.minRead}</span>
            </p>
          </article>
        </li>
      ))}
    </ol>
  )
}

{
  totalPages > 1 && (
    <nav class="pager" aria-label={ui.pagination}>
      {prev ? <a href={prev} rel="prev">← {ui.prev}</a> : <span />}
      <ol>
        {pages.map((p) => (
          <li>
            {p === page ? (
              <span aria-current="page">{p}</span>
            ) : (
              <a href={pageHref(p)} aria-label={`${ui.page} ${p}`}>{p}</a>
            )}
          </li>
        ))}
      </ol>
      {next ? <a href={next} rel="next">{ui.next} →</a> : <span />}
    </nav>
  )
}

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; }
  article h2 { font-size: 1.3rem; margin-bottom: 0.4rem; }
  article h2 a { text-decoration: none; }
  article h2 a:hover { text-decoration: underline; color: var(--cat-ink); }
  .list > li { border-left: 3px solid var(--cat-tint); padding-left: 1rem; transition: border-color 0.15s ease; }
  .list > li:hover { border-left-color: var(--cat); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--muted); margin: 0; }
  .pill { font-size: 0.72rem; font-weight: 700; padding: 0.05rem 0.55rem; border-radius: 999px; }
  .pill.new { background: var(--cat-ink); color: #fff; }
  .pill.cat { background: var(--cat-tint); color: var(--cat-ink); }
  .excerpt { margin-bottom: 0.35rem; max-width: 70ch; }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-top: 2.5rem; border: 1px solid var(--soft); border-radius: var(--radius); padding: 0.6rem 1rem; }
  .pager > a:last-child { justify-self: end; }
  .pager a { text-decoration: none; font-weight: 600; padding: 0.3rem 0.2rem; }
  .pager ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.25rem; flex-wrap: wrap; justify-content: center; }
  .pager ol a, .pager ol span { display: inline-grid; place-items: center; min-width: 2.25rem; height: 2.25rem; border-radius: var(--radius); }
  .pager ol span { background: var(--cat-ink, var(--fg)); color: #fff; font-weight: 700; }
  .pager a:hover { color: var(--cat-ink, var(--accent)); }
</style>
