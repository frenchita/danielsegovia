---
import { CATEGORIES, catStyle, type Locale } from '../lib/categories';
import { categoryHasPage, categoryUrl } from '../lib/content';
import { STATIC_PATHS, t } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = t(locale);
const current = Astro.url.pathname;

const links = await Promise.all(
  CATEGORIES.map(async (c) => {
    const own = await categoryHasPage(locale, c);
    const href = own ? categoryUrl(locale, c) : categoryUrl('es', c);
    return { href, style: catStyle(c), name: c[locale].name, lang: own ? undefined : 'es', active: current.startsWith(href) };
  }),
);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={STATIC_PATHS.home[locale]} title={ui.home}>
      <span aria-hidden="true" class="mark">DS</span>
      <span class="name">Daniel Segovia</span>
    </a>
    <nav class="nav" aria-label={ui.mainNav}>
      <ul>
        {
          links.map((l) => (
            <li style={l.style}>
              <a href={l.href} hreflang={l.lang} aria-current={l.active ? 'page' : undefined}>
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="search" href={STATIC_PATHS.search[locale]}>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <span>{ui.search}</span>
    </a>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--soft); }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo . search' 'nav nav nav';
    align-items: center;
    gap: 0.5rem 1rem;
    padding-top: 0.75rem;
    padding-bottom: 0.5rem;
  }
  .logo { grid-area: logo; display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-weight: 700; }
  .mark {
    display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem;
    border: 2px solid var(--line); border-radius: var(--radius); font-size: 0.85rem; letter-spacing: 0.02em;
  }
  .name { font-size: 1.05rem; }
  .nav { grid-area: nav; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px; }
  .nav::-webkit-scrollbar { display: none; }
  .nav ul { display: flex; gap: 1.1rem; list-style: none; margin: 0; padding: 0.25rem 0; white-space: nowrap; }
  .nav a { text-decoration: none; font-size: 0.92rem; color: var(--muted); padding: 0.35rem 0; display: inline-block; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--cat-ink); box-shadow: inset 0 -3px 0 var(--cat); }
  .search {
    grid-area: search; display: inline-flex; align-items: center; gap: 0.4rem;
    border: 1px solid var(--line); border-radius: var(--radius); padding: 0.35rem 0.8rem;
    text-decoration: none; font-size: 0.9rem; min-height: 2.25rem;
  }
  @media (min-width: 1024px) {
    .bar { grid-template-columns: auto 1fr auto; grid-template-areas: 'logo nav search'; padding-bottom: 0.75rem; }
    .nav { margin: 0; padding: 0; justify-self: end; }
  }
</style>
