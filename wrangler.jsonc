{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danielsegovia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // El sitio es HTML estático generado por Astro en ./dist.
  // El Worker solo se ejecuta para /api/*; todo lo demás lo sirve Static Assets.
  // La versión Markdown para agentes (Accept: text/markdown, ?mode=agent) se resuelve con
  // Transform Rules de la zona (reescritura a index.md / llms.txt), sin invocar el Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "danielsegovia",
      "database_id": "f33bc2e3-cd84-41c9-948c-e3a8ec37a0ac",
      "migrations_dir": "migrations"
    }
  ],
  // Cada 15 min: si alguna nota programada pasó su publish_at, dispara un rebuild.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
  // Secrets (wrangler secret put):
  //   API_TOKEN        -> token Bearer que usa n8n para escribir
  //   DEPLOY_HOOK_URL  -> URL del Deploy Hook de Workers Builds (rebuild al publicar)
}
